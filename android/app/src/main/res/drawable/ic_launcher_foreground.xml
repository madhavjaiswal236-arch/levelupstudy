<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="512"
    android:viewportWidth="512">
    
    <!-- Outer diamond / neon leveling frame -->
    <path
        android:pathData="M256,64 L448,256 L256,448 L64,256 Z"
        android:strokeWidth="32"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="64"
                android:startY="64"
                android:endX="448"
                android:endY="448"
                android:type="linear">
                <item android:color="#22D3EE" android:offset="0.0" />
                <item android:color="#3B82F6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner ascending level arrow/graph -->
    <path
        android:pathData="M160,320 L224,256 L288,320 L384,192"
        android:strokeWidth="48"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="384"
                android:startY="192"
                android:endX="160"
                android:endY="320"
                android:type="linear">
                <item android:color="#A855F7" android:offset="0.0" />
                <item android:color="#6366F1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Arrow head -->
    <path
        android:pathData="M384,192 L384,272 M384,192 L304,192"
        android:strokeWidth="48"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="384"
                android:startY="192"
                android:endX="304"
                android:endY="272"
                android:type="linear">
                <item android:color="#A855F7" android:offset="0.0" />
                <item android:color="#6366F1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
