### 3.1. Unified Canonical Task Completion Contract (Resolves Bug 2 & Bug 1B)
* **Location:** Create `src/lib/taskContract.ts`
* **Interface Specification:**
  ```typescript
  export interface TaskCompletionEvent {
    taskId: string;
    chapterId?: string;
    subjectId?: string;
    questionsCompleted: number;
    xpAwarded: number;
    completedAt: string;
    idempotencyKey: string;
    source: 'MANUAL' | 'BACKLOG' | 'SYLLABUS' | 'JEE_LOGGER';
  }
  ```
* **Authoritative Dispatcher Function:**
  ```typescript
  export function completeTaskCanonical(event: TaskCompletionEvent, state: AppState): AppState {
    // 1. Idempotency Guard: Prevent duplicate XP
    const alreadyRewarded = state.xpTransactions.some(tx => tx.idempotencyKey === event.idempotencyKey);
    const nextXp = alreadyRewarded ? state.xp : state.xp + event.xpAwarded;

    // 2. Atomic Todo State Update
    const nextTodos = state.todos.map(todo => 
      todo.id === event.taskId ? { ...todo, completed: true, completedAt: event.completedAt } : todo
    );

    // 3. Syllabus Propagation: Advance Chapter Lectures if chapterId is present
    let nextSyllabus = state.syllabus;
    if (event.chapterId && event.subjectId) {
      nextSyllabus = state.syllabus.map(subj => {
        if (subj.id !== event.subjectId) return subj;
        return {
          ...subj,
          chapters: subj.chapters.map(chap => {
            if (chap.id !== event.chapterId) return chap;
            const updatedLectures = chap.lectures.map(lec => 
              lec.id === event.taskId ? { ...lec, completed: true } : lec
            );
            const completedCount = updatedLectures.filter(l => l.completed).length;
            return {
              ...chap,
              lectures: updatedLectures,
              completedLectures: completedCount,
              masteryPercentage: Math.round((completedCount / chap.totalLectures) * 100)
            };
          })
        };
      });
    }

    return {
      ...state,
      todos: nextTodos,
      syllabus: nextSyllabus,
      xp: nextXp,
      xpTransactions: alreadyRewarded ? state.xpTransactions : [
        ...state.xpTransactions,
        { idempotencyKey: event.idempotencyKey, amount: event.xpAwarded, timestamp: event.completedAt }
      ]
    };
  }
  ```

