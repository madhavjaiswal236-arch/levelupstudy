rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper validation functions
    function isValidUserData(data) {
      return (!('xp' in data) || (data.xp is number && data.xp >= 0))
        && (!('level' in data) || (data.level is number && data.level >= 1 && data.level <= 100))
        && (!('streakDays' in data) || (data.streakDays is number && data.streakDays >= 0))
        && (!('questionsSolved' in data) || (data.questionsSolved is number && data.questionsSolved >= 0))
        && (!('hoursStudiedToday' in data) || (data.hoursStudiedToday is number && data.hoursStudiedToday >= 0))
        && (!('xpGainedToday' in data) || (data.xpGainedToday is number && data.xpGainedToday >= 0));
    }

    function isValidDelta(currData, nextData) {
      return (!('xp' in currData) || !('xp' in nextData) || nextData.xp >= currData.xp - 50000)
        && (!('level' in currData) || !('level' in nextData) || (nextData.level >= currData.level - 5 && nextData.level <= currData.level + 20));
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.size() < 800000
        && isValidUserData(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.size() < 800000
        && isValidUserData(request.resource.data)
        && isValidDelta(resource.data, request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Allow access to user subcollections (e.g. sessions, tasks, metrics) with size guard
      match /{allSubcollections=**} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.size() < 800000;
      }
    }

    // Default deny all other top-level collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

